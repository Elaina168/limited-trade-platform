{
  "uid": "limited-trade-messages",
  "title": "订单消息监控",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "limited-trade",
    "messages"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "description": "共享数据库和队列指标跨实例取最大值，不相加。队列计数不含unacked；采集失败为空，不等于0。2分钟无新样本时无数据。",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "待发送Outbox事件",
      "datasource": {
        "type": "loki",
        "uid": "limited-trade-loki"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(last_over_time({app=\"limited-trade\",source=\"java\"} | json event=\"event\", value=\"outboxPending\" | event=\"order_message_health\" | unwrap value | __error__=\"\" [2m]) by (instance))",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
